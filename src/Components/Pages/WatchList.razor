@page "/watchlist"
@inject GameState GameState
@inject TradingService TradingService
@implements IDisposable

<PageTitle>Watchlist - Wizard Stock Exchange</PageTitle>

<div class="page-header">
    <div class="header-content">
        <h1>Watchlist</h1>
        <p class="subtitle">Track stocks you're interested in</p>
    </div>
    @if (GameState.WatchList.Count > 0)
    {
        <button class="btn btn-secondary" @onclick="ClearAll">Clear All</button>
    }
</div>

@if (GameState.WatchList.Count == 0)
{
    <div class="empty-state">
        <h3>Watchlist is empty</h3>
        <p>Add stocks from the Market to track their performance</p>
        <a href="/" class="btn btn-primary">Browse Market</a>
    </div>
}
else
{
    <div class="stock-table-container">
        <table class="stock-table">
            <thead>
                <tr>
                    <th>Ticker</th>
                    <th>Company</th>
                    <th class="number">Price (£)</th>
                    <th class="number">Change</th>
                    <th class="number">Pred. Profit</th>
                    <th class="actions">Watch</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stock in GameState.WatchList)
                {
                    <tr @onclick="() => SelectStock(stock)">
                        <td class="ticker">@stock.Ticker</td>
                        <td class="company">@stock.Name</td>
                        <td class="number price">@stock.CurrentPrice.ToString("N2")</td>
                        <td class="number @(stock.PriceChange >= 0 ? "positive" : "negative")">
                            @(stock.PriceChange >= 0 ? "+" : "")@stock.PriceChange.ToString("N2")
                        </td>
                        <td class="number @(stock.PredictedProfitPercent >= 0 ? "positive" : "negative")">
                            @stock.PredictedProfitPercent.ToString("N2")%
                        </td>
                        <td class="actions">
                            <button class="btn-small btn-watch watching" @onclick="() => Remove(stock)" @onclick:stopPropagation="true">
                                ✓
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (SelectedStock != null)
{
    <TradeModal Stock="SelectedStock" OnClose="CloseModal" />
}

@code {
    private Stock? SelectedStock;

    protected override void OnInitialized()
    {
        GameState.OnStateChanged += OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void SelectStock(Stock stock) => SelectedStock = stock;
    private void CloseModal() => SelectedStock = null;
    private void Remove(Stock stock) => TradingService.RemoveFromWatchList(stock);
    private void ClearAll() => TradingService.ClearWatchList();

    public void Dispose()
    {
        GameState.OnStateChanged -= OnStateChanged;
    }
}
