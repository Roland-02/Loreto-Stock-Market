@inherits LayoutComponentBase
@inject GameState GameState

<div class="app-container">
    <nav class="top-navbar">
        <div class="nav-links">
            <NavLink href="/" Match="NavLinkMatch.All">Market</NavLink>
            <NavLink href="/portfolio">Portfolio</NavLink>
            <NavLink href="/watchlist">Watchlist</NavLink>
            <NavLink href="/history">History</NavLink>
            <NavLink href="/bank">Bank</NavLink>
        </div>
        
        <a href="/" class="nav-logo">
            <span class="logo-text">WSM</span>
        </a>
        
        <div class="nav-right">
            <div class="nav-stat">
                <span class="stat-label">Score</span>
                <span class="stat-value">@GameState.CurrentUser.Score</span>
            </div>
            <div class="nav-balance">
                <span class="balance-value">£@GameState.CurrentUser.Balance.ToString("N2")</span>
            </div>
        </div>
    </nav>
    
    <main class="main-content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        GameState.OnStateChanged += OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= OnStateChanged;
    }
}
