@inherits LayoutComponentBase
@inject GameState GameState

<div class="app-container">
    <nav class="sidebar">
        <div class="logo">
            <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <span class="logo-text">Wizard</span>
        </div>
        
        <div class="nav-section">
            <span class="nav-section-title">Trading</span>
            <div class="nav-links">
                <NavLink href="/" Match="NavLinkMatch.All">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 3v18h18"></path>
                        <path d="M18 17V9"></path>
                        <path d="M13 17V5"></path>
                        <path d="M8 17v-3"></path>
                    </svg>
                    <span>Market</span>
                </NavLink>
                <NavLink href="/portfolio">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                    <span>Portfolio</span>
                </NavLink>
                <NavLink href="/watchlist">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>Watchlist</span>
                </NavLink>
            </div>
        </div>
        
        <div class="nav-section">
            <span class="nav-section-title">Account</span>
            <div class="nav-links">
                <NavLink href="/history">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>History</span>
                </NavLink>
                <NavLink href="/bank">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="8" width="18" height="12" rx="2"></rect>
                        <path d="M7 8V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"></path>
                        <line x1="12" y1="12" x2="12" y2="16"></line>
                    </svg>
                    <span>Bank</span>
                </NavLink>
            </div>
        </div>
        
        <div class="user-stats">
            <div class="stat">
                <span class="stat-label">Balance</span>
                <span class="stat-value balance">£@GameState.CurrentUser.Balance.ToString("N2")</span>
            </div>
            <div class="stat">
                <span class="stat-label">Score</span>
                <span class="stat-value score">@GameState.CurrentUser.Score.ToString("N0")</span>
            </div>
        </div>
    </nav>
    <main class="main-content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        GameState.OnStateChanged += OnStateChanged;
    }

    private async void OnStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= OnStateChanged;
    }
}
