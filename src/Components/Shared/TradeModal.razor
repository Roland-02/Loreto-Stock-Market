@inject GameState GameState
@inject TradingService TradingService

<div class="modal-overlay" @onclick="OnClose">
    <div class="modal-content" @onclick:stopPropagation="true">
        <button class="modal-close" @onclick="OnClose">✕</button>
        
        <div class="stock-header">
            <div class="stock-title">
                <span class="ticker">@Stock.Ticker</span>
                <h2>@Stock.Name</h2>
            </div>
            <div class="stock-price-main">
                <span class="current-price">£@Stock.CurrentPrice.ToString("N2")</span>
                <span class="change @(Stock.PriceChange >= 0 ? "positive" : "negative")">
                    @(Stock.PriceChange >= 0 ? "▲" : "▼") @Math.Abs(Stock.PriceChange).ToString("N2") (@Stock.PercentChange.ToString("N2")%)
                </span>
            </div>
        </div>

        <div class="stock-stats">
            <div class="stat-card">
                <span class="stat-label">Day High</span>
                <span class="stat-value">£@Stock.High.ToString("N2")</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Day Low</span>
                <span class="stat-value">£@Stock.Low.ToString("N2")</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Volume</span>
                <span class="stat-value">@Stock.Volume.ToString("N0")</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Market Cap</span>
                <span class="stat-value">£@FormatMarketCap(Stock.MarketCap)</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Predicted</span>
                <span class="stat-value">£@Stock.PredictedValue.ToString("N2")</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Pred. Profit</span>
                <span class="stat-value @(Stock.PredictedProfitPercent >= 0 ? "positive" : "negative")">
                    @Stock.PredictedProfitPercent.ToString("N2")%
                </span>
            </div>
        </div>

        <div class="owned-info">
            <span>You own:</span>
            <span class="owned-shares">@Stock.OwnedShares.ToString("N0") shares</span>
            <span class="owned-value">(£@((Stock.OwnedShares * Stock.CurrentPrice).ToString("N2")))</span>
        </div>

        <div class="trade-section">
            <div class="quantity-input">
                <label>Quantity</label>
                <input type="number" @bind="Quantity" min="1" />
                <span class="cost-preview">Cost: £@((Quantity * Stock.CurrentPrice).ToString("N2"))</span>
            </div>
            <div class="trade-buttons">
                <button class="btn btn-buy" @onclick="Buy">Buy</button>
                <button class="btn btn-sell" @onclick="Sell" disabled="@(Stock.OwnedShares == 0)">Sell</button>
                <button class="btn-small btn-watch @(IsWatching ? "watching" : "")" @onclick="ToggleWatch">
                    @(IsWatching ? "✓" : "+")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="message @(IsError ? "error" : "success")">@Message</div>
        }

        @if (Stock.PriceHistory.Count > 1)
        {
            <div class="mini-chart">
                <h4>Price History</h4>
                <div class="chart-container">
                    @{
                        var prices = Stock.PriceHistory.TakeLast(20).ToList();
                        var min = prices.Min();
                        var max = prices.Max();
                        var mid = (min + max) / 2;
                        var range = max - min;
                        if (range == 0) range = 1;
                    }
                    <svg viewBox="0 0 500 180" class="price-chart" preserveAspectRatio="none">
                        <!-- Y-axis labels (price) -->
                        <text x="48" y="25" class="axis-label axis-y" text-anchor="end">£@max.ToString("N0")</text>
                        <text x="48" y="85" class="axis-label axis-y" text-anchor="end">£@mid.ToString("N0")</text>
                        <text x="48" y="145" class="axis-label axis-y" text-anchor="end">£@min.ToString("N0")</text>
                        
                        <!-- Y-axis line -->
                        <line x1="55" y1="10" x2="55" y2="150" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
                        
                        <!-- X-axis line -->
                        <line x1="55" y1="150" x2="495" y2="150" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
                        
                        <!-- Grid lines -->
                        <line x1="55" y1="80" x2="495" y2="80" stroke="rgba(255,255,255,0.08)" stroke-width="1" stroke-dasharray="4"/>
                        
                        <!-- Price line -->
                        <polyline
                            fill="none"
                            stroke="@(Stock.PriceChange >= 0 ? "#00d4aa" : "#ff6b6b")"
                            stroke-width="2.5"
                            points="@GetChartPoints(prices, min, range)" />
                        
                        <!-- X-axis labels (time) -->
                        <text x="55" y="172" class="axis-label axis-x" text-anchor="start">-@(prices.Count)m</text>
                        <text x="275" y="172" class="axis-label axis-x" text-anchor="middle">-@(prices.Count/2)m</text>
                        <text x="495" y="172" class="axis-label axis-x" text-anchor="end">Now</text>
                    </svg>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public required Stock Stock { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int Quantity = 1;
    private string Message = "";
    private bool IsError;

    private bool IsWatching => GameState.WatchList.Contains(Stock);

    private void ToggleWatch()
    {
        if (IsWatching)
        {
            TradingService.RemoveFromWatchList(Stock);
        }
        else
        {
            TradingService.AddToWatchList(Stock);
        }
    }

    private void Buy()
    {
        var result = TradingService.BuyStock(Stock, Quantity);
        Message = result.Message;
        IsError = !result.Success;
    }

    private void Sell()
    {
        var result = TradingService.SellStock(Stock, Quantity);
        Message = result.Message;
        IsError = !result.Success;
    }

    private string FormatMarketCap(decimal cap)
    {
        if (cap >= 1_000_000_000_000) return $"{cap / 1_000_000_000_000:N1}T";
        if (cap >= 1_000_000_000) return $"{cap / 1_000_000_000:N1}B";
        if (cap >= 1_000_000) return $"{cap / 1_000_000:N1}M";
        return cap.ToString("N0");
    }

    private string GetChartPoints(List<decimal> prices, decimal min, decimal range)
    {
        var points = new List<string>();
        var chartWidth = 440.0;
        var chartHeight = 130.0;
        var step = chartWidth / (prices.Count - 1);
        for (int i = 0; i < prices.Count; i++)
        {
            var x = 55 + (i * step);
            var y = 145 - (double)((prices[i] - min) / range) * chartHeight;
            points.Add($"{x:F1},{y:F1}");
        }
        return string.Join(" ", points);
    }
}
